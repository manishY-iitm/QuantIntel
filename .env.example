# QuantIntel Environment Configuration

# TinyFish Web Agent API (Search & Fetch)
# Obtain your API key from https://tinyfish.ai
TINYFISH_API_KEY=your_tinyfish_api_key_here
TINYFISH_BASE_URL=https://api.tinyfish.ai/v1

# LLM Reasoning Engine (OpenAI / Anthropic / Local Proxy)
# Optional: if not set, fallback rule-based or mock parsing is enabled
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Benchmark Ticker (e.g. S&P 500 ETF = SPY, Biotech ETF = XBI)
DEFAULT_BENCHMARK=SPY

# Backtesting Defaults
DEFAULT_ESTIMATION_WINDOW_DAYS=90
DEFAULT_EVENT_WINDOW_PRE=5
DEFAULT_EVENT_WINDOW_POST=10
